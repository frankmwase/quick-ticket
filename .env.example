# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quickticket?sslmode=disable

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── SMTP (Email Delivery) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=tickets@quickticket.io

# ── Malawi Pay Standard (MW-JSON) ────────────────────────────────────────────
MWJSON_BASE_URL=https://api.pay.mw
MWJSON_API_KEY=your-mwjson-api-key
MWJSON_MERCHANT_ID=your-merchant-id
